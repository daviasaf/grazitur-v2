{
  "name": "grazitur-dashboard",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "prisma generate && nuxt prepare",
    "seed": "node prisma/seed.mjs",
    "db:push": "npx prisma db push",
    "db:backfill-cpf": "node --experimental-strip-types prisma/backfill-cpf.ts",
    "test": "node --experimental-strip-types --test tests/cpf-security.test.ts tests/password-recovery.test.ts",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bootstrap": "^5.3.8",
    "fflate": "^0.8.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "nuxt": "4.5.2",
    "vue": "^3.5.32",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prisma": "^5.22.0",
    "supabase": "2.114.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.10"
  }
}
