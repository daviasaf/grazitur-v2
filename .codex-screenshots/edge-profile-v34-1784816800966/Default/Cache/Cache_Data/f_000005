  .trip-card-header, .payment-person-card, .contract-panel { flex-direction: column; align-items: stretch; }
  .payment-person-card .gt-btn, .contract-action-box .gt-btn { width: 100%; }
  .contract-action-box { align-items: stretch; flex-direction: column; }
  .admin-page { padding-left: 10px; padding-right: 10px; }
  .page-heading h2 { font-size: 22px; }
  .public-flow { max-width: 100%; }
}

