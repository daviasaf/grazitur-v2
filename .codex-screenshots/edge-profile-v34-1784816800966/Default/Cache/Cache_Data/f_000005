@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --gt-primary: #625bf6;
  --gt-primary-strong: #4f46e5;
  --gt-primary-soft: #eef2ff;
  --gt-bg: #f4f6fa;
  --gt-panel: #ffffff;
  --gt-border: #dde2ea;
  --gt-border-soft: #edf0f5;
  --gt-text: #0f172a;
  --gt-muted: #667085;
  --gt-muted-2: #98a2b3;
  --gt-success: #16a34a;
  --gt-success-soft: #e8f8ef;
  --gt-danger: #ef4444;
  --gt-danger-soft: #fff0f0;
  --gt-warning: #f59e0b;
  --gt-warning-soft: #fff7df;
  --gt-shadow: 0 1px 2px rgba(16, 24, 40, .06), 0 1px 3px rgba(16, 24, 40, .08);
  --gt-shadow-lg: 0 16px 48px rgba(15, 23, 42, .16);
}

* { box-sizing: border-box; }

html, body, #__nuxt { min-height: 100%; }

body {
  margin: 0;
  background: var(--gt-bg);
  color: var(--gt-text);
  font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  -webkit-font-smoothing: antialiased;
}

.text-brand { color: var(--gt-primary) !important; }

.text-muted-gt { color: var(--gt-muted) !important; }

.text-success-gt { color: var(--gt-success) !important; }

.text-danger-gt { color: var(--gt-danger) !important; }

.bg-surface { background: var(--gt-bg) !important; }

.bg-brand { background: var(--gt-primary) !important; color: #fff !important; }

.bg-brand-soft { background: var(--gt-primary-soft) !important; }

.rounded-gt { border-radius: 12px !important; }

.cursor-pointer { cursor: pointer; }

.shadow-soft { box-shadow: var(--gt-shadow) !important; }

.shadow-large { box-shadow: var(--gt-shadow-lg) !important; }

.gt-btn,
.btn.gt-btn {
  border-radius: 10px !important;
  min-height: 38px;
  padding: .55rem .9rem;
  font-weight: 700;
  font-size: .86rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .45rem;
  border: 1px solid transparent;
  transition: .18s ease;
  box-shadow: none;
}

.gt-btn-primary,
.btn-brand {
  background: var(--gt-primary) !important;
  border-color: var(--gt-primary) !important;
  color: #fff !important;
  box-shadow: 0 1px 2px rgba(79, 70, 229, .22);
}

.gt-btn-primary:hover,
.btn-brand:hover { background: var(--gt-primary-strong) !important; border-color: var(--gt-primary-strong) !important; color: #fff !important; }

.gt-btn-outline,
.btn-soft {
  background: #fff !important;
  color: #101828 !important;
  border-color: var(--gt-border) !important;
}

.gt-btn-outline:hover,
.btn-soft:hover { background: #f9fafb !important; border-color: #cfd6e2 !important; }

.gt-btn-danger { background: var(--gt-danger) !important; border-color: var(--gt-danger) !important; color: #fff !important; }

.gt-btn-danger:hover { filter: brightness(.95); }

.gt-btn-warning { background: #fff7ed !important; border-color: #fed7aa !important; color: #c2410c !important; }

.gt-btn-ghost { background: transparent !important; color: var(--gt-muted) !important; border-color: transparent !important; }

.gt-btn-ghost:hover { background: #f8fafc !important; color: var(--gt-text) !important; }

.gt-card {
  background: var(--gt-panel);
  border: 1px solid var(--gt-border);
  border-radius: 14px;
  box-shadow: var(--gt-shadow);
}

.gt-card-hover { transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }

.gt-card-hover:hover { transform: translateY(-2px); border-color: #c8d0dc; box-shadow: 0 8px 22px rgba(15,23,42,.09); }

.gt-subtle-card { background: #f9fafb; border: 1px solid var(--gt-border-soft); border-radius: 12px; }

.admin-shell { min-height: 100vh; display: flex; background: var(--gt-bg); }

.admin-sidebar {
  width: 202px;
  min-height: 100vh;
  background: #fff;
  border-right: 1px solid var(--gt-border);
  position: sticky;
  top: 0;
  flex-shrink: 0;
}

.admin-logo {
  height: 64px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 18px;
  font-weight: 800;
  border-bottom: 1px solid var(--gt-border);
  letter-spacing: -.03em;
}

.logo-icon {
  width: 30px;
  height: 30px;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #6d5dfc 0%, #4f46e5 100%);
  color: #fff;
  box-shadow: 0 8px 20px rgba(99, 91, 255, .24);
}

.admin-nav { padding: 14px 10px; display: flex; flex-direction: column; gap: 4px; }

.nav-section-label { color: var(--gt-muted-2); font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; margin: 14px 10px 6px; }

.admin-nav button {
  width: 100%;
  border: 0;
  background: transparent;
  color: #475467;
  border-radius: 10px;
  padding: 10px 11px;
  display: flex;
  align-items: center;
  gap: 9px;
  font-weight: 700;
  font-size: 13px;
  text-align: left;
  transition: .16s ease;
}

.admin-nav button .nav-icon { width: 18px; text-align: center; opacity: .82; }

.admin-nav button:hover { background: #f7f8fb; color: var(--gt-text); }

.admin-nav button.active { background: var(--gt-primary); color: #fff; box-shadow: 0 8px 18px rgba(99,91,255,.20); }

.admin-nav .nav-sub { padding-left: 9px; display: flex; flex-direction: column; gap: 4px; margin: 2px 0 2px 12px; border-left: 1px solid var(--gt-border); }

.admin-nav .nav-sub button { font-size: 12.5px; padding: 8px 10px; }

.admin-content { flex: 1; min-width: 0; }

.admin-topbar {
  height: 46px;
  background: #fff;
  border-bottom: 1px solid var(--gt-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  font-size: 15px;
  font-weight: 800;
}

.admin-page { padding: 20px; max-width: 1220px; }

.page-heading { display: flex; justify-content: space-between; align-items: center; gap: 14px; margin-bottom: 16px; }

.page-heading h2 { font-size: 22px; letter-spacing: -.035em; margin: 0; font-weight: 800; }

.page-heading p { margin: 4px 0 0; color: var(--gt-muted); font-size: 13px; }

.toolbar-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }

.metric-card {
  min-height: 112px;
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  padding: 20px;
}

.metric-label { color: var(--gt-muted); font-size: 12px; margin-bottom: 5px; }

.metric-value { font-size: 22px; font-weight: 800; line-height: 1.12; color: #000; letter-spacing: -.035em; }

.metric-icon {
  width: 36px;
  height: 36px;
  border-radius: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
}

.icon-green { color: var(--gt-success); background: var(--gt-success-soft); }

.icon-red { color: var(--gt-danger); background: var(--gt-danger-soft); }

.icon-blue { color: var(--gt-primary); background: var(--gt-primary-soft); }

.icon-orange { color: #c2410c; background: #fff7ed; }

.chart-card { padding: 18px; }

.chart-title { font-weight: 800; font-size: 14px; margin: 0 0 16px; }

.chart-wrap { height: 270px; display: flex; align-items: end; gap: 22px; padding: 18px 20px 12px; border-top: 1px dashed #d9dee8; }

.chart-group { flex: 1; min-width: 74px; display: flex; flex-direction: column; justify-content: end; align-items: center; height: 100%; }

.chart-bars { height: 205px; display: flex; align-items: end; gap: 7px; width: 100%; justify-content: center; border-bottom: 1px solid #94a3b8; }

.bar { width: 38%; border-radius: 5px 5px 0 0; min-height: 2px; }

.bar-receita { background: var(--gt-success); }

.bar-gasto { background: var(--gt-danger); }

.chart-label { margin-top: 9px; font-size: 11px; color: var(--gt-muted); text-align: center; width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.finance-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }

.finance-pill { background: #f8fafc; border: 1px solid var(--gt-border-soft); border-radius: 12px; padding: 10px; }

.finance-pill span { display: block; color: var(--gt-muted); font-size: 11px; margin-bottom: 4px; }

.finance-pill strong { font-size: 13px; }

.breakdown-list { display: flex; flex-direction: column; gap: 7px; }

.breakdown-row { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; padding-top: 7px; border-top: 1px solid var(--gt-border-soft); }

.breakdown-row:first-child { border-top: 0; padding-top: 0; }

.excursion-card-title { font-size: 15px; font-weight: 800; letter-spacing: -.02em; }

.excursion-info-box { background: #f8fafc; border-radius: 12px; padding: 12px; border: 1px solid var(--gt-border-soft); }

.progress.gt-progress { height: 6px; background: #edf0f5; border-radius: 999px; overflow: hidden; }

.progress.gt-progress .progress-bar { border-radius: 999px; }

.badge-gt { border-radius: 7px; padding: 5px 8px; font-size: 11px; font-weight: 800; border: 1px solid transparent; }

.badge-contract { background: #dff7eb; color: #047857; border-color: #b7ebd1; }

.badge-finalizada { background: #eef2ff; color: #4f46e5; border-color: #d7dcff; }

.badge-warning-gt { background: var(--gt-warning-soft); color: #92400e; border-color: #fde68a; }

.table-gt { width: 100%; border-collapse: separate; border-spacing: 0; overflow: hidden; }

.table-gt th { color: #475569; font-size: 12px; text-transform: uppercase; font-weight: 800; padding: 11px 10px; border-bottom: 1px solid var(--gt-border); background: #f8fafc; }

.table-gt th:first-child { border-top-left-radius: 10px; }

.table-gt th:last-child { border-top-right-radius: 10px; }

.table-gt td { padding: 11px 10px; border-bottom: 1px solid var(--gt-border-soft); font-size: 13px; vertical-align: middle; }

.table-gt tr:last-child td { border-bottom: 0; }

.table-gt tr:hover td { background: #fbfcff; }

.form-control, .form-select { border-color: var(--gt-border); border-radius: 10px; }

.form-control:focus, .form-select:focus { box-shadow: 0 0 0 .22rem rgba(99, 91, 255, .12); border-color: var(--gt-primary); }

.modal-content { border-radius: 16px !important; }

.modal-header, .modal-footer { border-color: var(--gt-border-soft) !important; }

.form-check-input:checked { background-color: var(--gt-primary); border-color: var(--gt-primary); }

.toast { border-radius: 12px !important; }

.public-shell { min-height: 100vh; background: radial-gradient(circle at top, #ffffff 0, #f4f6fa 42%, #eef2ff 100%); }

.auth-card { max-width: 430px; width: 100%; }

.public-excursion-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }

@media (max-width: 900px) {
  .admin-shell { display: block; }
  .admin-sidebar { position: relative; width: 100%; min-height: auto; }
  .admin-logo { height: 56px; }
  .admin-nav { flex-direction: row; overflow-x: auto; gap: 6px; padding: 10px; }
  .admin-nav button { white-space: nowrap; width: auto; flex-shrink: 0; }
  .admin-nav .nav-sub { flex-direction: row; border-left: 0; margin: 0; padding-left: 0; }
  .nav-section-label { display: none; }
  .admin-page { padding: 14px; }
  .page-heading { align-items: flex-start; flex-direction: column; }
  .toolbar-actions { width: 100%; }
  .toolbar-actions .gt-btn { flex: 1; }
  .chart-wrap { overflow-x: auto; }
  .chart-group { min-width: 112px; }
  .finance-grid { grid-template-columns: 1fr; }
}

/* Bootstrap helpers adjusted to keep the dashboard style closer to Nuxt Dashboard */

.btn.rounded-pill { border-radius: 10px !important; }

.badge.rounded-pill { border-radius: 7px !important; }

/* v3 polish inspired by Nuxt Dashboard */

.bg-brand-light { background: var(--gt-primary-soft) !important; }

.border-brand { border-color: rgba(98, 91, 246, .28) !important; }

.gt-modal-backdrop { background: rgba(15, 23, 42, .58); overflow-y: auto; }

.gt-modal-header { background: #fff; border-bottom: 1px solid var(--gt-border-soft); }

.gt-btn-success { background: #16a34a !important; border-color: #16a34a !important; color: #fff !important; }

.gt-icon-btn { width: 34px; height: 34px; border-radius: 9px; border: 1px solid var(--gt-border-soft); background: #fff; display: inline-flex; align-items: center; justify-content: center; transition: .16s ease; }

.gt-icon-btn:hover { background: #f8fafc; border-color: var(--gt-border); transform: translateY(-1px); }

.search-popover { background: #fff; border: 1px solid var(--gt-border); border-radius: 12px; overflow: hidden; box-shadow: var(--gt-shadow-lg); }

.search-row { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px; border: 0; border-bottom: 1px solid var(--gt-border-soft); background: #fff; text-align: left; }

.search-row:hover { background: #f8fafc; }

.search-row small { display: block; color: var(--gt-muted); }

.passenger-hero { display: flex; justify-content: space-between; align-items: center; gap: 16px; background: linear-gradient(180deg, #fff 0%, #fbfcff 100%); }

.interest-card { display: flex; flex-direction: column; justify-content: space-between; min-height: 152px; }

.pix-code-box { max-height: 120px; overflow-y: auto; }

.public-form-card { max-width: 980px; margin: 0 auto; }

.contract-toggle-card { background: linear-gradient(180deg, #fff 0%, #fbfcff 100%); }

.admin-topbar .gt-btn { min-height: 34px; }

.passageiros-table { border-radius: 14px; }

@media (max-width: 900px) {
  body { background: #f6f8fc; }
  .admin-shell { display: block; }
  .admin-sidebar { width: 100%; min-height: auto; position: sticky; top: 0; z-index: 1020; box-shadow: 0 1px 0 var(--gt-border); }
  .admin-logo { height: 58px; padding: 0 14px; }
  .admin-nav { display: grid; grid-template-columns: repeat(4, minmax(92px, 1fr)); gap: 6px; overflow-x: auto; padding: 8px 10px 10px; scrollbar-width: none; }
  .admin-nav::-webkit-scrollbar { display: none; }
  .admin-nav button { width: 100%; min-width: 92px; justify-content: center; flex-direction: column; gap: 4px; padding: 8px 10px; font-size: 11px; border: 1px solid transparent; }
  .admin-nav button .nav-icon { width: auto; font-size: 15px; }
  .admin-nav button.active { box-shadow: 0 5px 12px rgba(99, 91, 255, .20); }
  .admin-nav .nav-sub { display: contents; }
  .admin-nav > button:nth-of-type(2) { display: none; }
  .nav-section-label { display: none; }
  .admin-topbar { height: 50px; padding: 0 14px; }
  .admin-topbar span { font-size: 14px; }
  .admin-page { padding: 14px 12px 80px; }
  .page-heading { flex-direction: column; align-items: stretch; gap: 12px; }
  .page-heading h2 { font-size: 21px; }
  .toolbar-actions { width: 100%; display: grid; grid-template-columns: 1fr; }
  .toolbar-actions input { max-width: none !important; width: 100%; }
  .toolbar-actions .gt-btn { width: 100%; }
  .metric-card { min-height: 96px; padding: 16px; }
  .metric-value { font-size: 20px; }
  .chart-card { padding: 14px; }
  .chart-wrap { height: 230px; padding: 14px 10px 10px; gap: 14px; overflow-x: auto; }
  .chart-bars { height: 168px; }
  .chart-group { min-width: 86px; }
  .modal-dialog { margin: .5rem auto; }
  .modal-body { padding: 1rem !important; }
  .modal-header, .modal-footer { padding: 1rem !important; }
  .gt-card { border-radius: 13px; }
  .passenger-hero { align-items: stretch; flex-direction: column; }
  .passenger-hero .gt-btn { width: 100%; }
  .auth-card { margin-top: 22px; }
}

@media (max-width: 560px) {
  .admin-nav { grid-template-columns: repeat(4, 92px); }
  .admin-logo span:last-child { font-size: 16px; }
  .admin-page { padding-left: 10px; padding-right: 10px; }
  .gt-btn { min-height: 40px; font-size: .82rem; }
  .finance-grid { grid-template-columns: 1fr; }
  .public-shell { padding-top: 0 !important; }
  .public-excursion-grid { grid-template-columns: 1fr; }
  .table-responsive .table-gt { min-width: 520px; }
}

/* v4 dashboard-template polish */

.dropdown-gt { position: relative; }

.dropdown-gt-menu {
  position: absolute;
  right: 0;
  top: 40px;
  z-index: 20;
  min-width: 190px;
  padding: 6px;
  background: #fff;
  border: 1px solid var(--gt-border);
  border-radius: 12px;
  box-shadow: var(--gt-shadow-lg);
}

.dropdown-gt-menu button {
  width: 100%;
  border: 0;
  background: transparent;
  color: var(--gt-text);
  text-align: left;
  padding: 9px 10px;
  border-radius: 9px;
  font-weight: 700;
  font-size: 13px;
}

.dropdown-gt-menu button:hover { background: #f8fafc; }

.gt-btn-xs { min-height: 32px; padding: .35rem .6rem; font-size: .78rem; }

.trip-actions-layout { display: grid; grid-template-columns: 1fr 1fr 1fr minmax(320px, auto); gap: 12px; align-items: stretch; }

.trip-actions-buttons { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 8px; }

.passenger-list-card { border-radius: 14px; }

.passenger-list-table td { padding-top: 13px; padding-bottom: 13px; }

.passenger-line { display: flex; gap: 8px; align-items: flex-start; }

.passenger-name { display: block; line-height: 1.2; }

.dependent-row td { background: #fbfcff; }

.dependent-mark { color: var(--gt-muted); font-weight: 800; margin-top: 2px; }

.whatsapp-link { color: #059669; font-weight: 800; text-decoration: none; }

.whatsapp-link:hover { color: #047857; text-decoration: underline; }

.download-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }

.download-option { border: 1px solid var(--gt-border); padding: 22px 16px; text-align: center; background: #fff; transition: .18s ease; }

.download-option:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(15,23,42,.09); }

.download-option span { display: block; font-size: 28px; margin-bottom: 8px; }

.download-option strong { display: block; font-size: 16px; }

.download-option small { color: var(--gt-muted); }

.waitlist-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 14px 16px; border-bottom: 1px solid var(--gt-border-soft); }

.waitlist-row:last-child { border-bottom: 0; }

.public-hero-card { overflow: hidden; display: grid; grid-template-columns: 1.05fr .95fr; align-items: stretch; padding: 0; }

.public-hero-copy { padding: 28px; text-align: left; }

.public-hero-image { min-height: 320px; background: #e7eafe; position: relative; }

.public-hero-image img { width: 100%; height: 100%; -o-object-fit: cover; object-fit: cover; display: block; }

.place-chip-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }

.place-chip { background: #fff; border: 1px solid var(--gt-border); color: #344054; border-radius: 999px; padding: 6px 10px; font-size: 12px; font-weight: 800; box-shadow: 0 1px 1px rgba(16,24,40,.04); }

.public-action-card { text-align: left; transition: .18s ease; border: 1px solid var(--gt-border) !important; }

.public-action-card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(15,23,42,.09); border-color: #c9d0dc !important; }

.public-action-icon { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; background: var(--gt-primary-soft); color: var(--gt-primary); font-size: 22px; margin-bottom: 14px; }

.sidebar-chevron { margin-left: auto; color: var(--gt-muted-2); font-size: 13px; transition: transform .18s ease; }

.sidebar-chevron.open { transform: rotate(90deg); }

.admin-nav .nav-sub button.active { background: #f4f3ff; color: var(--gt-primary); box-shadow: none; }

.admin-nav > button.active-soft { background: #f7f8fb; color: var(--gt-text); }

.admin-nav > button.active-soft .nav-icon { color: var(--gt-primary); }

@media (max-width: 980px) {
  .trip-actions-layout { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .trip-actions-buttons { grid-column: 1 / -1; justify-content: flex-start; }
  .public-hero-card { grid-template-columns: 1fr; }
  .public-hero-image { min-height: 260px; }
}

@media (max-width: 560px) {
  .trip-actions-layout { grid-template-columns: 1fr; }
  .trip-actions-buttons { display: grid; grid-template-columns: 1fr; }
  .download-grid { grid-template-columns: 1fr; }
  .waitlist-row { align-items: stretch; flex-direction: column; }
  .waitlist-row .gt-btn { width: 100%; }
}

.submenu-enter-active, .submenu-leave-active { transition: opacity .14s ease, transform .14s ease; }

.submenu-enter-from, .submenu-leave-to { opacity: 0; transform: translateY(-4px); }

.passenger-hero-actions { display: grid; grid-template-columns: repeat(2, minmax(150px, auto)); gap: 8px; align-items: center; }

.passenger-hero-actions .gt-btn-danger { grid-column: 1 / -1; justify-self: start; }

@media (max-width: 560px) { .passenger-hero-actions { grid-template-columns: 1fr; } .passenger-hero-actions .gt-btn-danger { justify-self: stretch; } }

/* v5 mobile-first polish */

.logo-icon { font-size: 12px !important; font-weight: 900; letter-spacing: -.04em; }

.mono-icon { display: block; color: var(--gt-primary); font-size: 28px; line-height: 1; margin-bottom: 8px; }

.section-title { font-size: 16px; font-weight: 850; letter-spacing: -.025em; margin: 0; }

.dashboard-trip-section { margin-bottom: 28px; }

.success-mark { color: var(--gt-success); font-size: 42px; line-height: 1; font-weight: 900; }

.whatsapp-button { display: inline-flex; margin-top: 8px; color: #047857; background: #ecfdf3; border: 1px solid #bbf7d0; border-radius: 8px; padding: 5px 8px; font-size: 12px; font-weight: 800; text-decoration: none; }

.whatsapp-button:hover { color: #065f46; background: #dcfce7; }

.contract-actions-inline { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6px; }

