/* v11 UX polish: cleaner mobile passenger flow, stronger admin modal actions and contract parity */

.gt-btn-danger-outline {
  background: transparent !important;
  color: var(--gt-danger) !important;
  border-color: color-mix(in srgb, var(--gt-danger) 42%, var(--gt-border)) !important;
  box-shadow: none !important;
}

.gt-btn-danger-outline:hover {
  background: var(--gt-danger-soft) !important;
  color: var(--gt-danger) !important;
  transform: translateY(-1px);
}

.trip-command-center {
  display: grid;
  grid-template-columns: minmax(280px, 1fr) minmax(360px, auto);
  gap: 12px;
  align-items: stretch;
}

.trip-status-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.trip-status-item {
  background: var(--gt-panel);
  border: 1px solid var(--gt-border);
  border-radius: 16px;
  box-shadow: var(--gt-shadow);
  padding: 14px 16px;
  min-height: 82px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.trip-status-item span {
  color: var(--gt-muted);
  font-size: 12px;
  font-weight: 750;
  margin-bottom: 4px;
}

.trip-status-item strong {
  font-size: 22px;
  line-height: 1;
  letter-spacing: -.04em;
}

.trip-action-panel {
  background: var(--gt-panel);
  border: 1px solid var(--gt-border);
  border-radius: 16px;
  box-shadow: var(--gt-shadow);
  padding: 10px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}

.trip-action-panel .gt-btn {
  width: 100%;
  min-height: 52px;
  white-space: normal;
  line-height: 1.14;
}

.contract-mini-status {
  color: var(--gt-success);
  font-weight: 850;
  font-size: 12px;
}

.passenger-family-card {
  padding: 18px;
  margin-bottom: 16px;
}

.family-list-clean {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.family-list-clean span {
  border: 1px solid var(--gt-border);
  color: var(--gt-text);
  background: var(--gt-panel-2);
  border-radius: 999px;
  padding: 7px 10px;
  font-size: 12px;
  font-weight: 800;
