  margin: 0 0 4px;
  font-size: 23px;
  font-weight: 950;
  letter-spacing: -.055em;
}

.passenger-trip-top p {
  margin: 0;
  color: var(--gt-muted) !important;
}

.passenger-trip-top > strong {
  flex-shrink: 0;
  color: var(--gt-primary) !important;
  background: var(--gt-primary-soft);
  border: 1px solid color-mix(in srgb, var(--gt-primary) 24%, var(--gt-border));
  border-radius: 999px;
  padding: 7px 10px;
