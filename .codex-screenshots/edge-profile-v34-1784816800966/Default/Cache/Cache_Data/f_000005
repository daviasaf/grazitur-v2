.mobile-payment-list { display: grid; gap: 9px; margin-bottom: 14px; }

.payment-person-card { border: 1px solid var(--gt-border); border-radius: 13px; padding: 12px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }

