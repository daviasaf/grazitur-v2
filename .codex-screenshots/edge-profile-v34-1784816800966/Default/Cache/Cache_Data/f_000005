/* Dark mode exact fixes */

[data-theme="dark"] .public-shell { background: radial-gradient(circle at top left, rgba(99,91,255,.20), transparent 32%), var(--gt-bg) !important; }

[data-theme="dark"] .public-site-header, [data-theme="dark"] .admin-topbar { background: rgba(16, 25, 43, .86) !important; }

[data-theme="dark"] .gt-card-hover:hover, [data-theme="dark"] .public-action-card:hover { background: #142037 !important; }

[data-theme="dark"] .badge-gt.bg-white, [data-theme="dark"] .bg-white { background: var(--gt-panel) !important; color: var(--gt-text) !important; }

[data-theme="dark"] .bg-light, [data-theme="dark"] .alert-info { background: var(--gt-panel-2) !important; color: var(--gt-text) !important; }

