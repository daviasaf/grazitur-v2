.payment-person-card strong { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.contract-panel { border: 1px solid var(--gt-border); border-radius: 14px; padding: 14px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }

