.interest-status { background: var(--gt-primary-soft); border: 1px solid color-mix(in srgb, var(--gt-primary) 35%, var(--gt-border)); color: var(--gt-primary); border-radius: 11px; padding: 11px; font-size: 13px; font-weight: 850; text-align: center; }

